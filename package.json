{
  "name": "personal-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "oxfmt --check && oxlint --type-aware --deny-warnings && tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "lighthouse": "lhci autorun --config=.github/lighthouserc.json",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "simple-icons": "16.37.0"
  },
  "devDependencies": {
    "@lhci/cli": "0.16.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
